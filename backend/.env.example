# MeinKursHeft backend secrets. Copy to backend/.env (which is gitignored) and
# fill in real values. Generate both lines with:
#
#   node scripts/set-password.js "dein-passwort"
#
# scrypt hash of the single app password (never the plaintext password):
AUTH_PASSWORD_HASH=
# random secret used to sign the session cookie (openssl rand -hex 32):
AUTH_SECRET=

# Optional: override the port (default 4000).
# PORT=4000
# Optional: comma-separated list of browser origins allowed to call the API.
# ALLOWED_ORIGINS=https://meinkursheft.duckdns.org
